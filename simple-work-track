#!/usr/bin/env bash
set -euo pipefail

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/worktrack"
STATE="${XDG_RUNTIME_DIR:-/tmp}/worktrack_on"

mkdir -p "$DIR"

now() { date +%s; }
day_of() { date -d "@$1" +%F; }
next_midnight() { date -d "$(date -d "@$1" +%F) +1 day" +%s; }

save_day() {
    local d="$1"
    local add="$2"
    local file="$DIR/$d.json"

    local old=0
    [[ -f "$file" ]] && old=$(jq -r '.seconds // 0' "$file")

    local total=$((old + add))

    jq -n \
        --arg date "$d" \
        --argjson seconds "$total" \
        '{
            date: $date,
            seconds: $seconds
        }' > "$file"
}

split_range() {
    local start="$1"
    local end="$2"

    while (( start < end )); do
        local d mid next

        d=$(day_of "$start")
        mid=$(next_midnight "$start")

        if (( end < mid )); then
            next=$end
        else
            next=$mid
        fi

        save_day "$d" $((next - start))
        start=$next
    done
}

total_from_files() {
    local total=0
    shopt -s nullglob

    for f in "$DIR"/*.json; do
        total=$((total + $(jq -r '.seconds // 0' "$f")))
    done

    echo "$total"
}

cmd_on() {
    if [[ -f "$STATE" ]]; then
        echo "already running" >&2
        exit 1
    fi

    date +%s > "$STATE"
}

cmd_off() {
    if [[ ! -f "$STATE" ]]; then
        echo "not running" >&2
        exit 1
    fi

    local start end
    start=$(cat "$STATE")
    end=$(now)

    rm -f "$STATE"

    split_range "$start" "$end"
}

cmd_status() {
    local total=0

    if [[ -f "$STATE" ]]; then
        local start now
        start=$(cat "$STATE")
        now=$(now)

        # compute temporary contribution without modifying state
        while (( start < now )); do
            local mid next
            mid=$(next_midnight "$start")

            if (( now < mid )); then
                next=$now
            else
                next=$mid
            fi

            total=$((total + next - start))
            start=$next
        done
    fi

    total=$((total + $(total_from_files)))

    printf "%s seconds\n" "$total"
}

cmd_log() {
    local n=7
    [[ $# -ge 2 ]] && n="$2"

    shopt -s nullglob

    ls -1t "$DIR"/*.json 2>/dev/null | head -n "$n" | while read -r f; do
        local d s
        d=$(jq -r '.date' "$f")
        s=$(jq -r '.seconds' "$f")
        printf "%s %s seconds\n" "$d" "$s"
    done
}

cmd="${1:-*}"

case "$cmd" in
    on)     cmd_on ;;
    off)    cmd_off ;;
    status) cmd_status ;;
    log)    cmd_log "$@" ;;
    *)
        echo "usage: work-track {on|off|status|log}" >&2
        exit 1
        ;;
esac
