#!/usr/bin/env bash
set -euo pipefail

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/worktrack"
STATE="${XDG_RUNTIME_DIR:-/tmp}/worktrack_on"

mkdir -p "$DIR"

now() { date +%s; }
day_of() { date -d "@$1" +%F; }
next_midnight() { date -d "$(date -d "@$1" +%F) +1 day" +%s; }

fmt_dur() {
    local t=$1 h m s
    h=$((t / 3600)); m=$(( (t % 3600) / 60 )); s=$((t % 60))
    printf "%dh %02dm %02ds" "$h" "$m" "$s"
}

save_day() {
    local d="$1"
    local add="$2"
    local file="$DIR/$d.json"

    local old=0
    [[ -f "$file" ]] && old=$(jq -r '.seconds // 0' "$file")

    local total=$((old + add))

    jq -n \
        --arg date "$d" \
        --argjson seconds "$total" \
        '{
            date: $date,
            seconds: $seconds
        }' > "$file"
}

split_range() {
    local start="$1"
    local end="$2"
    local mode="${3:-save}"
    local total=0

    while (( start < end )); do
        local d mid next delta

        d=$(day_of "$start")
        mid=$(next_midnight "$start")

        if (( end < mid )); then
            next=$end
        else
            next=$mid
        fi

        delta=$((next - start))

        if [[ "$mode" == save ]]; then
            save_day "$d" "$delta"
        else
            total=$((total + delta))
        fi

        start=$next
    done

    [[ "$mode" == sum ]] && echo "$total"
}

total_from_files() {
    local total=0
    shopt -s nullglob

    for f in "$DIR"/*.json; do
        total=$((total + $(jq -r '.seconds // 0' "$f")))
    done

    printf "%s\n" "$(fmt_dur $total)"
}

cmd_on() {
    [[ -f "$STATE" ]] && return 0
    date +%s > "$STATE"
}

cmd_off() {
    [[ -f "$STATE" ]] || return 0

    local start end
    start=$(cat "$STATE")
    end=$(now)

    rm -f "$STATE"

    split_range "$start" "$end"
}

cmd_status() {
    [[ -f "$STATE" ]] || return 0

    local start end
    start=$(cat "$STATE")
    end=$(now)

    fmt_dur "$(split_range "$start" "$end" sum)"
}

cmd_save() {
    [[ -f "$STATE" ]] || return 0

    local start end
    start=$(cat "$STATE")
    end=$(now)

    split_range "$start" "$end" save

    echo "saved"
}

cmd_log() {
    local n=7
    [[ $# -ge 2 ]] && n="$2"

    shopt -s nullglob

    ls -1t "$DIR"/*.json 2>/dev/null | head -n "$n" | while read -r f; do
        local d s
        d=$(jq -r '.date' "$f")
        s=$(jq -r '.seconds' "$f")
        printf "%s  %s\n" "$d" "$(fmt_dur $s)"
    done
}

case "${1:-}" in
    on|off|status|save|log) "cmd_${1:-status}" "$@" ;;
    *)
        echo "Usage: work-track {on|off|status|save|log}" >&2
        exit 1 ;;
esac
