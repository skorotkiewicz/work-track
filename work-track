#!/usr/bin/env bash
set -euo pipefail

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/worktrack"
STATE="${XDG_RUNTIME_DIR:-/tmp}/worktrack_on"

mkdir -p "$DIR"

now() { date +%s; }
day_of() { date -d "@$1" +%F; }
next_midnight() { date -d "$(date -d "@$1" +%F) +1 day" +%s; }

fmt_dur() {
    local t=$1 h m s
    h=$((t / 3600)); m=$(( (t % 3600) / 60 )); s=$((t % 60))
    printf "%dh %02dm %02ds" "$h" "$m" "$s"
}

save_day() {
    local d="$1"
    local add="$2"
    local file="$DIR/$d.json"

    local old=0
    [[ -f "$file" ]] && old=$(jq -r '.seconds // 0' "$file")

    local total=$((old + add))

    jq -n \
        --arg date "$d" \
        --argjson seconds "$total" \
        '{
            date: $date,
            seconds: $seconds
        }' > "$file.tmp"
    mv -f "$file.tmp" "$file"   # atomic: no half-written day on crash
}

split_range() {
    local start="$1"
    local end="$2"
    local mode="${3:-save}"
    local total=0

    while (( start < end )); do
        local d mid next delta

        d=$(day_of "$start")
        mid=$(next_midnight "$start")

        if (( end < mid )); then
            next=$end
        else
            next=$mid
        fi

        delta=$((next - start))

        if [[ "$mode" == save ]]; then
            save_day "$d" "$delta"
        else
            total=$((total + delta))
        fi

        start=$next
    done

    # plain if: '[[ ]] &&' returns 1 in save mode and set -e kills the script
    if [[ "$mode" == sum ]]; then echo "$total"; fi
}

cmd_on() {
    if [[ -f "$STATE" ]]; then
        echo "already running" >&2
        exit 1
    fi

    date +%s > "$STATE"
}

read_state() {
    local s
    s=$(<"$STATE")
    if [[ ! "$s" =~ ^[0-9]+$ ]]; then
        echo "corrupt state file, discarding" >&2
        rm -f "$STATE"
        exit 1
    fi
    echo "$s"
}

cmd_off() {
    if [[ ! -f "$STATE" ]]; then
        echo "not running" >&2
        exit 1
    fi

    local start end
    start=$(read_state)
    end=$(now)

    split_range "$start" "$end"   # save first,
    rm -f "$STATE"                # drop state only on success
}

cmd_status() {
    if [[ ! -f "$STATE" ]]; then
        echo "not running" >&2
        exit 1
    fi

    local start end
    start=$(read_state)
    end=$(now)

    fmt_dur "$(split_range "$start" "$end" sum)"
    echo
}

cmd_save() {
    if [[ ! -f "$STATE" ]]; then
        echo "not running" >&2
        exit 1
    fi

    local start end
    start=$(read_state)
    end=$(now)

    split_range "$start" "$end" save
    echo "$end" > "$STATE"   # reset start, else next off/save double-counts

    echo "saved"
}

cmd_log() {
    local n=7
    [[ $# -ge 2 ]] && n="$2"

    shopt -s nullglob
    local files=("$DIR"/*.json)
    ((${#files[@]})) || return 0

    # names are YYYY-MM-DD.json, so reverse lexical sort = newest first
    printf '%s\n' "${files[@]}" | sort -r | head -n "$n" | while read -r f; do
        local d s
        d=$(jq -r '.date // empty' "$f")
        s=$(jq -r '.seconds // 0' "$f")
        printf "%s  %s\n" "$d" "$(fmt_dur "$s")"
    done
}

case "${1:-status}" in
    on|off|status|save|log) "cmd_${1:-status}" "$@" ;;
    *)
        echo "Usage: work-track {on|off|status|save|log}" >&2
        exit 1 ;;
esac
