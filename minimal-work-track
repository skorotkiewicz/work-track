#!/usr/bin/env bash
set -euo pipefail

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/worktrack"
STATE="${XDG_RUNTIME_DIR:-/tmp}/worktrack_on"
mkdir -p "$DIR"

now(){ date +%s; }
day(){ date -d "@$1" +%F; }
mid(){ date -d "$(date -d "@$1" +%F) +1 day" +%s; }

save(){
  f="$DIR/$1.json"
  old=0
  [[ -f "$f" ]] && old=$(jq -r '.seconds//0' "$f")
  jq -n --arg date "$1" --argjson seconds $((old+$2)) '{date:$date,seconds:$seconds}' > "$f"
}

split(){
  a=$1 b=$2
  while ((a<b)); do
    d=$(day "$a"); m=$(mid "$a")
    ((b<m)) && m=$b
    save "$d" $((m-a))
    a=$m
  done
}

case "${1:-}" in
on)
  [[ -f "$STATE" ]] && exit 1
  date +%s > "$STATE"
  ;;

off)
  [[ -f "$STATE" ]] || exit 1
  s=$(cat "$STATE"); e=$(now)
  rm -f "$STATE"
  split "$s" "$e"
  ;;

*)
  echo "worktrack {on|off}"
  ;;
esac
